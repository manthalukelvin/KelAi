# Get free key at https://console.groq.com  (no credit card needed)
GROQ_API_KEY=gsk_your_free_key_here

# Optional password protection
APP_PASSWORD=

PORT=3000
NODE_ENV=production

# Default model - use only these working ones:
# llama-3.1-8b-instant          ← fastest + highest free limits (recommended)
# llama-3.3-70b-versatile       ← strongest quality
# openai/gpt-oss-20b
# openai/gpt-oss-120b
# meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=llama-3.1-8b-instant
